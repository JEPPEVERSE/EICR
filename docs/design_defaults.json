      "text_normalization": "unicode_nfc_and_whitespace_only",
      "preserve_native_id_aliases": true,
      "merge_different_origins_by_text": false,
      "merge_same_source_different_facts": false
    }
  },
  "incidence": {
    "format": "csr",
    "native_edge_weight": 1.0,
    "absent_edge_weight": 0.0,
    "duplicate_edge_reduction": "max",
    "derived_edges_in_direct_matrix": false,
    "preserve_existing_owner_injected_edges_with_origin_flag": true,
    "create_new_owner_injected_edges": false,
    "zero_row_status": "unavailable"
  },
  "coordinate_weights": {
    "mode": "equal_family_mass_equal_unique_fact_mass_within_family",
    "family_definition": "connected_components_of_evidence_and_explicit_source_roots",
    "source_root_merge": "explicit_derivation_or_copy_records_only",
    "weight_formula": "1 / (family_count * unique_facts_in_family)",
    "weight_sum": 1.0,
    "family_is_event": false,
    "family_implies_statistical_independence": false,
    "report_family_size_distribution": true,
    "empty_index_status": "empty_index"
  },
  "facets": {
    "preserve_cue_facet_evidence_triples": true,
    "tag_namespace": "owner_and_normalized_tag_text",
    "topic_namespace": "owner_session_native_topic_id",
    "merge_same_topic_text_across_sessions": false,
    "multi_tag_allocation": "native_weights_if_present_else_equal_sum_one_per_cue_evidence",
    "missing_tag_bucket": "unclassified",
    "facet_feature_formula": "R_ce * sqrt(w_e * allocation_cte)",
    "default_tag_neighbors": false,
    "facet_is_additional_vote": false,
    "multiply_global_cue_tag_by_tag_content_into_R": false
  },
  "neighbor_candidate": {
    "kind": "native_topic_weak_expansion",
    "topic_min_df": 2,
    "topic_max_df_absolute": 64,
    "topic_max_df_fraction": 0.05,
    "topic_max_df_floor": 2,
    "topic_max_df_formula": "min(64, max(2, floor(0.05 * N)))",
    "exclude_whole_hub_topic": true,
    "max_topics_per_evidence": 32,
    "topic_selection_order": ["df_ascending", "topic_id_ascending"],
    "topic_similarity": "idf_weighted_jaccard_of_retained_eligible_topics",
    "topic_idf_formula": "log((N + 1) / (df + 1)) + 1",
    "topic_strength_multiplier": 0.25,
    "explicit_links_enabled": false,
    "explicit_link_type_allowlist": [],
    "explicit_link_strength": 1.0,
    "max_explicit_candidates_per_evidence_if_enabled": 64,
    "strength_combination": "max",
    "min_neighbor_strength": 0.05,
    "max_nonself_neighbors": 8,
    "neighbor_order": ["strength_descending", "target_id_ascending"],
    "force_symmetric_edges": false,
    "automatic_same_turn_session_day_speaker_edges": false,
    "record_edge_provenance_and_pruning": true,
    "attenuation_formula": "r_e = max_retained_neighbor_strength",
    "transition_off_diagonal": "P_ef = r_e * g_ef / sum_nonself_g_e",
    "transition_self": "P_ee = 1 - r_e",
    "no_neighbor_transition": "self_loop_one",
    "transition_row_sum": 1.0
  },
  "representation": {
    "direct_formula": "X = R * sqrt(W)",
    "transition_formula": "T = (1 - beta) * I + beta * P",
    "expanded_formula": "Y = X * T",
    "channel_normalization": "separate_l2",
    "combined_formula": "concat(sqrt(1-lambda)*normalized_X, sqrt(lambda)*normalized_Y)",
    "similarity_formula": "(1-lambda)*cosine_X + lambda*cosine_Y",
    "lambda_is_index_wide": true,
    "profiles": {
      "weighted_direct": {
        "default": true,
        "structure_enabled": false,
        "lambda": 0.0,
        "transition_when_disabled": "identity"
      },
      "weighted_direct_plus_native_topic": {
        "default": false,
        "structure_enabled": true,
        "beta": 0.25,
        "lambda": 0.2,
        "expansion_steps": 1
      }
    },
    "require_beta_in_half_open_unit_interval": true,
    "require_lambda_in_half_open_unit_interval": true,
    "direct_vector_truncation": null,
    "expanded_vector_truncation": null,
    "materialize_full_pairwise_matrix": false,
    "store_sparse_channels_instead_of_concatenated_dense_vectors": true,
    "no_neighbors_globally_status": "structure_active_false",
    "dtype": "float64"
  },
  "frontend": {
    "extract_complete_event_constraints": false,
    "max_initial_llm_calls": 1,
    "max_format_retries": 1,
    "max_entry_mentions": 24,
    "max_ambiguous_candidates_per_mention": 3,
    "span_indexing": "unicode_codepoint_half_open",
    "eligible_match_methods": ["unique_exact", "unique_explicit_alias"],
    "fuzzy_candidate_method": "positive_token_jaccard_then_cue_id",
    "ambiguous_candidates_can_vote": false,
    "ambiguous_candidates_can_inform_auxiliary_retrieval": true,
    "unmapped_creates_persistent_cue": false,
    "unmapped_means_wrong": false,
    "preserve_original_question": true,
    "answer_need_is_voting_cue": false,
    "scope_owner_is_voting_cue": false,
    "on_failure_or_truncation": "ORIGINAL",
    "mapping_coverage_is_semantic_completeness": false
