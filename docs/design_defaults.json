  "diagnostics": {
    "report_channels_separately": true,
    "report_directional_direct_coverage": true,
    "report_direct_joint_mass_and_normalized_joint_support": true,
    "empty_or_zero_mass_joint_support": "unavailable",
    "no_joint_witness_is_proof_of_conflict": false,
    "participation_weight": "1 - direct_evidence_mass / total_coordinate_mass",
    "scope_participation_weight": 0.0,
    "deduplicate_same_canonical_cue": true,
    "group_exactly_identical_nonzero_R_rows": true,
    "identical_row_group_weight": "max_member_weight",
    "identical_rows_imply_semantic_aliases": false,
    "near_identical_rows_are_automatically_merged": false,
    "suspicion_formula": "weighted_peer_pair_cohesion_minus_weighted_cue_to_peer_affinity",
    "min_effective_groups_for_single_check": 3,
    "suspicion_is_error_probability": false,
    "zero_vector_similarity": null
  },
  "routing": {
    "adaptive_routing_enabled": false,
    "policy_status": "UNCONFIGURED",
    "policy_manifest_path": null,
    "thresholds": {
