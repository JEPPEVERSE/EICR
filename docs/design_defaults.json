    "require_all_extracted_entry_mentions_unique_and_nonzero": true,
    "max_selected_cue_count": 1,
    "selected_identical_row_group_must_be_singleton": true,
    "tie_policy": "do_not_select_single_cue",
    "exact_directional_containment_blocks_single_or_pair_check": true,
    "explicit_multi_target_mode": "ORIGINAL",
    "two_groups_can_assign_wrong_cue": false,
    "two_group_check_is_symmetric": true,
    "modify_original_query": false,
    "automatic_replacement_cue": false
  },
  "retrieval": {
    "original_query_backend": "shared_dense_plus_bm25",
    "original_rrf_k": 60,
    "answer_need_backend": "shared_bm25",
    "answer_need_additional_embedding_calls": 0,
    "core_pool": "union_of_remaining_groups_direct_evidence_origins",
    "core_order": [
