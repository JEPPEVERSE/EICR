{
  "schema_version": "eicr-design-1.0",
  "document_date": "2026-11-18",
  "status": "DESIGN_ONLY_NOT_IMPLEMENTED",
  "method": "Evidence-Induced Cue Representation",
  "specification": "design_v1_zh.md",
  "parameter_status": {
    "mathematical_contracts": "required_invariants",
    "resource_limits": "unvalidated_engineering_starting_points",
    "representation_parameters": "unvalidated_candidates",
    "routing_thresholds": "unconfigured_requires_grouped_development_selection",
    "runtime_requirements": "must_be_supplied_in_a_frozen_run_manifest"
  },
  "scope": {
    "cue_definition": "existing_mragent_style_semantic_label",
    "evidence_definition": "existing_rewritten_fact_with_raw_origins",
    "cue_vector_source": "downstream_evidence_incidence_and_optional_structure",
    "cue_text_embedding_required": false,
    "event_identity_required": false,
    "similarity_is_probability": false,
    "global_cue_cue_graph": false,
    "automatic_query_correction": false,
    "new_offline_llm_calls": 0
  },
  "snapshot": {
    "isolation": ["owner_id", "snapshot_id"],
    "filter_before_statistics": true,
    "require_all_origins_allowed": true,
    "require_extraction_prefix_provenance": true,
    "dangling_reference_policy": "fail_formal_build",
    "quarantine_mode_for_audit_only": true,
    "update_strategy": "immutable_full_rebuild",
    "forbid_online_gold_fields": true
  },
  "identity": {
    "preserve_native_cue_identity": true,
    "lookup_normalization": "unicode_nfc_whitespace_and_casefold_without_identity_merge",
    "alias_source": "explicit_versioned_snapshot_legal_records_only",
    "evidence_dedup": {
      "key_fields": [
        "owner_id",
        "complete_canonical_origin_set",
        "conservatively_normalized_rewrite_text",
        "compatible_native_metadata"
